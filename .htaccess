# MyPress Apache hardening. Nginx deployments must apply equivalent rules.
Options -Indexes
DirectoryIndex index.php

# Protect the live config and any installer temp/backup sibling (for example
# config.php.installing) even if PHP execution is unavailable on the host.
<FilesMatch "(?i)^config\.php(?:\..*)?$">
    Require all denied
</FilesMatch>

# Block private application data and dotfiles.
RedirectMatch 404 ^/data(?:/|$)
RedirectMatch 404 /\.(?!well-known/)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^post/([^/]+)/?$ index.php?post=$1 [L,QSA]
    RewriteRule ^page/([^/]+)/?$ index.php?page=$1 [L,QSA]
    RewriteRule ^product/([^/]+)/?$ index.php?product=$1 [L,QSA]
    RewriteRule ^shop/?$ index.php?shop=1 [L,QSA]
</IfModule>
